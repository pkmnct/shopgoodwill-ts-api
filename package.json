{
    "name": "shopgoodwill-ts-api",
    "version": "0.2.0",
    "description": "TypeScript client for the Shopgoodwill buyer API",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pkmnct/shopgoodwill-ts-api.git"
    },
    "author": "George W. Walker",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/pkmnct/shopgoodwill-ts-api/issues"
    },
    "engines": {
        "node": ">=22"
    },
    "type": "module",
    "main": "index.js",
    "types": "index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.js"
        }
    },
    "files": [
        "*.js",
        "*.d.ts",
        "*.map",
        "!eslint.config.js",
        "!*.test.js",
        "!*.test.d.ts",
        "!*.test.js.map",
        "!*.test.d.ts.map"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "prepublishOnly": "npm run build",
        "test": "tsc && node --test \"*.test.js\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@types/node": "^22.0.0",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.14.0",
        "eslint-plugin-promise": "^7.3.0",
        "semantic-release": "^25.0.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2"
    }
}
